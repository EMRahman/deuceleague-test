{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deuceleague-test",
  "main": "deploy/cloudflare/src/worker.ts",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "PUBLIC_URL": "https://deuceleague-test.ehsanr-web.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "deuceleague",
      // Provisioning is intentionally unbound to the maintainer's account.
      "migrations_dir": "packages/db-d1/migrations","database_id": "ee77af3f-6da6-4850-aabd-66d2990552d9"
    }
  ]
}
